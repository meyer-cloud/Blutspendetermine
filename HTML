<style>
    :root {
        --drk-font-h4: 22px;
        --drk-font-p: 15px;
        --drk-font-time: 18px;
        --drk-font-date: 24px;
        --drk-red: #be3228;
    }

    .drk-modern-container {
        width: 100%;
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
        box-sizing: border-box;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .drk-headline {
        text-align: center;
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 40px;
        color: #1a1a1a;
    }

    .drk-main-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
        align-items: stretch;
    }

    .drk-section-grid {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    /* TERMIN KARTEN */
    .drk-red-card {
        flex: 1;
        background: var(--drk-red);
        color: #fff !important;
        text-decoration: none !important;
        border-radius: 16px;
        display: flex;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(190, 50, 40, 0.2);
    }

    .drk-date-box {
        background: rgba(0,0,0,0.12);
        padding: 20px;
        min-width: 110px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        border-right: 1px solid rgba(255,255,255,0.1);
    }
    .drk-date-box .wday { font-size: 42px; font-weight: 900; text-transform: uppercase; line-height: 1; }
    .drk-date-box .full { font-size: 14px; font-weight: 600; margin-top: 5px; }

    .drk-text-box { flex: 1; padding: 25px; display: flex; flex-direction: column; justify-content: center; }
    .drk-text-box h4 { margin: 0; font-size: var(--drk-font-h4); font-weight: 800; }
    .drk-text-box p { margin: 2px 0 12px; font-size: var(--drk-font-p); opacity: 0.9; line-height: 1.3; }
    
    .drk-meta { display: flex; justify-content: space-between; align-items: center; }
    .drk-time-label { font-size: var(--drk-font-time); font-weight: 700; }
    .drk-res-button { background: #fff; color: var(--drk-red) !important; padding: 8px 16px; font-size: 12px; font-weight: 900; text-transform: uppercase; border-radius: 8px; }

    /* INFOBOXEN */
    .drk-info-card {
        flex: 1;
        background: #f8f9fa;
        border: 1px solid #eef0f2;
        border-radius: 16px;
        padding: 30px;
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    .drk-badge { 
        width: 45px; height: 45px; border-radius: 50%; display: flex; 
        align-items: center; justify-content: center; color: #fff; 
        font-size: 20px; font-weight: bold; flex-shrink: 0; margin-top: -2px; 
    }
    .red-bg { background: var(--drk-red); }
    .blue-bg { background: #005aa9; }
    
    .drk-card-content { flex: 1; }
    .drk-card-content h3 { margin: 0 0 8px; font-size: 16px; font-weight: 800; color: #222; }
    .drk-card-content p { margin: 0 0 10px; font-size: 15px; color: #555; line-height: 1.5; }
    .drk-card-content a { color: var(--drk-red); font-weight: 700; text-decoration: none; font-size: 15px; }
    .drk-phone-val { font-weight: 800; color: #111; font-size: 15px; display: block; margin-top: 5px; }

    /* RESPONSIVE */
    @media (max-width: 1024px) {
        .drk-main-grid { grid-template-columns: 1fr; }
        .drk-section-grid { display: grid; grid-template-columns: 1fr 1fr; }
        .drk-red-card { flex-direction: column; }
        .drk-date-box { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.1); width: 100%; min-width: 0; padding: 15px; }
    }

    @media (max-width: 700px) {
        :root {
            --drk-font-h4: 16px; --drk-font-p: 13px; --drk-font-time: 14px; --drk-font-date: 20px;
        }
        #drk-appointment-target { grid-template-columns: 1fr 1fr; gap: 10px; }
        .drk-info-group { grid-template-columns: 1fr; gap: 15px; }
        .drk-date-box { flex-direction: row; justify-content: flex-start; padding: 10px 15px; gap: 10px; }
        .drk-date-box .wday, .drk-date-box .full { font-size: var(--drk-font-date); margin: 0; }
    }
</style>

<script>
async function loadDRKPremium() {
    const rss = "https://www.blutspendedienst-west.de/blutspendetermine/termine.rss?term=66128";
    const api = "https://api.rss2json.com/v1/api.json?rss_url=" + encodeURIComponent(rss);
    
    try {
        const res = await fetch(api);
        const data = await res.json();
        const target = document.getElementById("drk-appointment-target");
        
        if(!data.items || data.items.length === 0) {
            target.innerHTML = "<p>Aktuell keine Termine verfügbar.</p>";
            return;
        }

        let html = "";
        data.items.slice(0, 2).forEach(item => {
            // 1. Ort extrahieren (zwischen PLZ und " am")
            // Beispiel: "66111 Saarbrücken am 13.07.2026..." -> "Saarbrücken"
            const ortMatch = item.title.match(/^\d{5}\s+(.*?)\s+am/);
            const ort = ortMatch ? ortMatch[1] : "Blutspende";

            // 2. Adresse aus description (Bindestriche entfernen)
            // Beispiel: "- Ursulinenstr. 67 - Johannesfoyer" -> "Ursulinenstr. 67 - Johannesfoyer"
            const strasse = item.description.replace(/^[\s-äöüÄÖÜß]+|[\s-]+$/g, '').trim();
            
            // 3. Datum & Zeit
            const dMatch = item.title.match(/am (\d{2}\.\d{2}\.\d{4})/);
            const tMatch = item.title.match(/(\d{2}:\d{2})\s*Uhr\s*bis\s*(\d{2}:\d{2})/i);
            
            const dStr = dMatch ? dMatch[1] : "";
            const tStr = tMatch ? `${tMatch[1]} - ${tMatch[2]} Uhr` : "Zeit n.V.";
            
            const p = dStr.split('.');
            const dateObj = new Date(p[2], p[1]-1, p[0]);
            const wday = dateObj.toLocaleDateString('de-DE', {weekday: 'short'}).replace('.','').toUpperCase();

            html += `
                <a href="${item.link}" target="_blank" class="drk-red-card">
                    <div class="drk-date-box">
                        <span class="wday">${wday}</span>
                        <span class="full">${dStr}</span>
                    </div>
                    <div class="drk-text-box">
                        <h4>${ort}</h4>
                        <p>${strasse}</p>
                        <div class="drk-meta">
                            <span class="drk-time-label">${tStr}</span>
                            <div class="drk-res-button">Reservieren</div>
                        </div>
                    </div>
                </a>`;
        });
        target.innerHTML = html;
    } catch (e) { 
        target.innerHTML = "<p>Fehler beim Laden der Termine.</p>";
    }
}
loadDRKPremium();
</script>
