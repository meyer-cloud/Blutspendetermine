<script>
    // =========================================================================
    // KONFIGURATION (Änderungen hier vornehmen)
    // =========================================================================
    const DRK_RSS_URL = "https://www.blutspendedienst-west.de/blutspendetermine/termine.rss?term=66128";
    const MAX_TERMINS = 2; 
</script>

<div class="drk-modern-container">
    <h2 class="drk-headline">Blutspende-Termine in der Region</h2>

    <div class="drk-main-grid">
        <div id="drk-appointment-target" class="drk-section-grid" aria-live="polite">
            <p class="drk-status-text">Termine werden geladen...</p>
        </div>

        <div class="drk-section-grid">
            <div class="drk-info-card">
                <div class="drk-badge red-bg" aria-hidden="true">✓</div>
                <div class="drk-card-content">
                    <h3>SPENDE-CHECK</h3>
                    <p>Prüfen Sie in wenigen Schritten, ob Sie Blut spenden können.</p>
                    <a href="https://www.blutspendedienst-west.de/blutspende/checken" target="_blank" rel="noopener">Zum Online-Check →</a>
                </div>
            </div>

            <div class="drk-info-card">
                <div class="drk-badge blue-bg" aria-hidden="true">?</div>
                <div class="drk-card-content">
                    <h3>HABEN SIE FRAGEN?</h3>
                    <p>Der DRK-Blutspendedienst beantwortet Ihre Fragen gerne auch persönlich:</p>
                    <a href="tel:08001194911" class="drk-phone-val">0800 11 949 11 (kostenfrei)</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function initDrkWidget() {
        const target = document.getElementById("drk-appointment-target");
        const apiEndpoint = "https://api.rss2json.com/v1/api.json?rss_url=" + encodeURIComponent(DRK_RSS_URL);
        
        try {
            const response = await fetch(apiEndpoint);
            if (!response.ok) throw new Error();
            const data = await response.json();
            
            if (!data.items || data.items.length === 0) {
                target.innerHTML = "<p class='drk-status-text'>Aktuell keine Termine in Ihrer Region verfügbar.</p>";
                return;
            }

            let htmlOutput = "";
            
            data.items.slice(0, MAX_TERMINS).forEach(item => {
                const ortMatch = item.title.match(/^(\d{5})\s+(.*?)\s+am/);
                const plz = ortMatch ? ortMatch[1] : "";
                const ortRein = ortMatch ? ortMatch[2].trim() : "Blutspendetermin";

                const rawDescription = item.description ? item.description.replace(/^[\s-äöüÄÖÜß]+|[\s-]+$/g, '').trim() : "";
                let strasse = rawDescription;
                let lokal = "";

                if (rawDescription.includes(" - ")) {
                    const teile = rawDescription.split(" - ");
                    strasse = teile[0].trim();
                    lokal = teile[1].trim();
                }

                let kompletteAdresse = lokal ? `${lokal}, ${strasse}` : strasse;
                kompletteAdresse += plz ? `, ${plz} ${ortRein}` : `, ${ortRein}`;
                
                const dMatch = item.title.match(/am (\d{2}\.\d{2}\.\d{4})/);
                const tMatch = item.title.match(/(\d{2}:\d{2})\s*Uhr\s*bis\s*(\d{2}:\d{2})/i);
                
                const dStr = dMatch ? dMatch[1] : "";
                const tStr = tMatch ? `${tMatch[1]} - ${tMatch[2]} Uhr` : "Zeit nach Vereinbarung";
                
                let wday = "INFO";
                if (dStr) {
                    const p = dStr.split('.');
                    if (p.length === 3) {
                        const dateObj = new Date(p[2], p[1] - 1, p[0]);
                        if (!isNaN(dateObj.getTime())) {
                            wday = dateObj.toLocaleDateString('de-DE', {weekday: 'short'}).replace('.', '').toUpperCase();
                        }
                    }
                }

                htmlOutput += `
                    <a href="${item.link}" target="_blank" rel="noopener" class="drk-red-card">
                        <div class="drk-date-box">
                            <span class="wday">${wday}</span>
                            <span class="full">${dStr}</span>
                        </div>
                        <div class="drk-text-box">
                            <h4>${ortRein}</h4>
                            <p>${kompletteAdresse}</p>
                            <div class="drk-meta">
                                <span class="drk-time-label">${tStr}</span>
                                <span class="drk-res-button">Reservieren</span>
                            </div>
                        </div>
                    </a>`;
            });
            
            target.innerHTML = htmlOutput;
        } catch (e) { 
            target.innerHTML = "<p class='drk-status-text error'>Termine konnten nicht geladen werden.</p>";
        }
    }

    document.addEventListener("DOMContentLoaded", initDrkWidget);
</script>

